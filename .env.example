# Database (Neon PostgreSQL serverless with WebSocket connection)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/medplatform?sslmode=require

# Distributed Concurrency Locks & Caching (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Asynchronous Background Workflows & Sagas (Inngest)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Transactional Email (Primary & Fallback)
RESEND_API_KEY=re_your_resend_api_key
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_FROM=Healthcare Platform <noreply@yourdomain.com>

# Generative AI Triage & Clinical Discharge (Google GenAI Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key

# Google Calendar OAuth 2.0 Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Firebase Authentication (Client-side - Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Authentication (Server-side - Admin)
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
